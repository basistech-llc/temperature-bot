### /etc/systemd/system/temperature-bot-performance-monitor.service ###
[Unit]
Description=Record AE-200 network performance probes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=temperature_bot
Group=temperature_bot
WorkingDirectory=/opt/temperature-bot/current
Environment="PATH=/opt/temperature-bot/current/venv/bin:/usr/bin:/bin"
Environment="DB_PATH=/var/db/temperature_bot/temperature-bot.db"
Environment="TEMPERATURE_BOT_INSTANCE=production"
Environment="PERFORMANCE_CLIENT_ID=network-probe"
ExecStart=/opt/temperature-bot/current/venv/bin/python -m bin.performance_monitor --once
