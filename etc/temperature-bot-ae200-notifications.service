### /etc/systemd/system/temperature-bot-ae200-notifications.service ###
[Unit]
Description=Collect unsolicited AE-200 state notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=temperature_bot
Group=temperature_bot
WorkingDirectory=/opt/temperature-bot/current
Environment="PATH=/opt/temperature-bot/current/venv/bin:/usr/bin:/bin"
Environment="DB_PATH=/var/db/temperature_bot/temperature-bot.db"
Environment="TEMPERATURE_BOT_INSTANCE=production"
EnvironmentFile=-/etc/temperature-bot-ae200-notifications.env
ExecStart=/opt/temperature-bot/current/venv/bin/python -m bin.ae200_notifications
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
