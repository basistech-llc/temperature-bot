# Install as /etc/temperature-bot/deg1.env with mode 0640.
DB_PATH=/home/deg/var/db/temperature-bot.db
TEMPERATURE_BOT_CONFIG=/home/deg/temperature-bot/temperature-bot-config.yaml
TEMPERATURE_BOT_INSTANCE=deg1
TEMPERATURE_BOT_DATABASE_IDENTITY=deg1
TEMPERATURE_BOT_DATABASE_ROOT=/home/deg/var/db
TEMPERATURE_BOT_CONTROL_MODE=simulator
TEMPERATURE_BOT_SCHEDULER_MODE=disabled
AE200_SIMULATOR=1
HUBITAT_SIMULATOR=1
AIRTHINGS_SIMULATOR=1
AQICN_SIMULATOR=1
GIT_COMMIT=SET_DURING_DEPLOYMENT
GIT_BRANCH=codex/issue-241-simulator-instances
LOG_LEVEL=INFO
