# Install as /etc/temperature-bot/air-stage.env with mode 0640.
DB_PATH=/home/air-stage/var/db/temperature-bot.db
TEMPERATURE_BOT_CONFIG=/etc/temperature-bot/config.yaml
TEMPERATURE_BOT_INSTANCE=air-stage
TEMPERATURE_BOT_DATABASE_IDENTITY=air-stage
TEMPERATURE_BOT_DATABASE_ROOT=/home/air-stage/var/db
TEMPERATURE_BOT_CONTROL_MODE=live
TEMPERATURE_BOT_SCHEDULER_MODE=enabled
AE200_SIMULATOR=0
HUBITAT_SIMULATOR=0
AIRTHINGS_SIMULATOR=0
AQICN_SIMULATOR=0
GIT_COMMIT=SET_DURING_DEPLOYMENT
GIT_BRANCH=codex/issue-239-air-stage
LOG_LEVEL=INFO
